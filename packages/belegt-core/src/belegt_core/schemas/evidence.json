{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.belegt.org/graph/2026-10/evidence.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "id",
    "source_type",
    "fact_key",
    "extracted_value",
    "value_type",
    "boundary",
    "locator",
    "valid_from",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "org_id": true,
    "version": true,
    "created_at": true,
    "created_by": true,
    "trust_zone": true,
    "provenance": true,
    "supersedes": true,
    "schema_version": true,
    "content_hash": true,
    "tags": true,
    "source_type": {
      "enum": [
        "document",
        "erp",
        "human_confirmation",
        "supplier_response",
        "historical_answer",
        "public_source"
      ]
    },
    "datapoint_id": {
      "$ref": "common.json#/$defs/datapointRef"
    },
    "fact_key": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$"
    },
    "value_type": {
      "enum": [
        "number",
        "text",
        "enum",
        "bool",
        "date",
        "file",
        "geo"
      ]
    },
    "extracted_value": true,
    "unit": {
      "type": "string",
      "maxLength": 32
    },
    "period": {
      "$ref": "common.json#/$defs/period"
    },
    "boundary": {
      "$ref": "common.json#/$defs/boundary"
    },
    "locator": {
      "type": "object",
      "properties": {
        "blob_sha256": {
          "$ref": "common.json#/$defs/sha256"
        },
        "mime": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "sheet": {
          "type": "string"
        },
        "cell": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "text_excerpt_hash": {
          "$ref": "common.json#/$defs/sha256"
        },
        "connector": {
          "type": "object",
          "required": [
            "connector_id",
            "query_hash",
            "record_key",
            "fetched_at"
          ],
          "properties": {
            "connector_id": {
              "type": "string"
            },
            "query_hash": {
              "$ref": "common.json#/$defs/sha256"
            },
            "record_key": {
              "type": "string"
            },
            "fetched_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "cq_ref": {
          "type": "string",
          "pattern": "^cq_[0-9A-HJKMNP-TV-Z]{26}#v[1-9][0-9]*$"
        },
        "approval_ref": {
          "type": "string",
          "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}#v[1-9][0-9]*$"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "by"
      ],
      "properties": {
        "method": {
          "enum": [
            "auto_rule",
            "closed_question",
            "human_review",
            "connector_attested"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "cq_ref": {
          "type": "string"
        },
        "by": {
          "$ref": "common.json#/$defs/actor"
        }
      }
    },
    "supplier_request_ref": {
      "type": "string",
      "pattern": "^sreq_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "corrects": {
      "type": "string",
      "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}#v[1-9][0-9]*$"
    },
    "plausibility": {
      "type": "object",
      "required": [
        "flag"
      ],
      "properties": {
        "flag": {
          "enum": [
            "ok",
            "outlier",
            "unit_suspect"
          ]
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "expired",
        "superseded",
        "rejected"
      ]
    },
    "promotion": {
      "$ref": "common.json#/$defs/promotion"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelope"
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "number"
          }
        }
      },
      "then": {
        "required": [
          "unit"
        ],
        "properties": {
          "extracted_value": {
            "$ref": "common.json#/$defs/decStr"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "document"
          }
        }
      },
      "then": {
        "properties": {
          "locator": {
            "required": [
              "blob_sha256"
            ],
            "anyOf": [
              {
                "required": [
                  "page"
                ]
              },
              {
                "required": [
                  "cell"
                ]
              },
              {
                "required": [
                  "bbox"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "erp"
          }
        }
      },
      "then": {
        "properties": {
          "locator": {
            "required": [
              "connector"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "human_confirmation"
          }
        }
      },
      "then": {
        "properties": {
          "created_by": {
            "pattern": "^user:"
          },
          "locator": {
            "anyOf": [
              {
                "required": [
                  "cq_ref"
                ]
              },
              {
                "required": [
                  "approval_ref"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "supplier_response"
          }
        }
      },
      "then": {
        "required": [
          "supplier_request_ref",
          "plausibility"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ],
        "properties": {
          "trust_zone": {
            "const": "trusted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trust_zone": {
            "const": "quarantine"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      }
    }
  ],
  "$comment": "03 §5.3 原文 + properties.promotion（R-PROMO 晋升 supplier_response 证据所需；原文遗漏，见 README 与文档出入）"
}