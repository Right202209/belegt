{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.belegt.org/graph/2026-10/factor_set.json",
  "title": "FactorSet",
  "type": "object",
  "required": [
    "id",
    "source",
    "license",
    "published_at",
    "valid_from",
    "row_count",
    "rows_hash",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fs:[a-z0-9-]+@[0-9A-Za-z.\\-]+$"
    },
    "org_id": true,
    "version": true,
    "created_at": true,
    "created_by": true,
    "trust_zone": {
      "const": "trusted"
    },
    "provenance": true,
    "supersedes": true,
    "schema_version": true,
    "content_hash": true,
    "tags": true,
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "license": {
      "type": "string"
    },
    "published_at": {
      "$ref": "common.json#/$defs/date"
    },
    "valid_from": {
      "$ref": "common.json#/$defs/date"
    },
    "valid_until": {
      "$ref": "common.json#/$defs/date"
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "rows_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "status": {
      "enum": [
        "active",
        "deprecated"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelope"
    }
  ]
}