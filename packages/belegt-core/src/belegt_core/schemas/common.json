{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.belegt.org/graph/2026-10/common.json",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "objectRef": {
      "type": "string",
      "pattern": "^(req|q|map|ev|calc|ans|apr|cfl|sreq|cq|cp|site|prod)_[0-9A-HJKMNP-TV-Z]{26}#v[1-9][0-9]*$"
    },
    "datapointRef": {
      "type": "string",
      "pattern": "^dp:[a-z]+(\\.[a-z0-9_]+){2,3}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "decStr": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 40
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^(user:[a-z0-9_]+|agent:(intake-triage|question-parser|evidence-miner|calc-service|consistency-auditor|answer-drafter|approval-router|upstream-chaser|supplier-reply-reviewer|filler|reg-radar|sales-assistant|guard|egress-gateway)|service:[a-z-]+)$"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "string",
      "pattern": "^(organization|product_per_unit|site:site_[0-9A-HJKMNP-TV-Z]{26}|product:prod_[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "customerScope": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cp_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      ]
    },
    "i18nText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 8000
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "id",
        "org_id",
        "version",
        "created_at",
        "created_by",
        "trust_zone",
        "provenance",
        "schema_version",
        "content_hash"
      ],
      "properties": {
        "org_id": {
          "type": "string",
          "pattern": "^(org_[0-9A-HJKMNP-TV-Z]{26}|org_global)$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "$ref": "#/$defs/actor"
        },
        "trust_zone": {
          "enum": [
            "quarantine",
            "trusted"
          ]
        },
        "provenance": {
          "type": "string",
          "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/objectRef"
            }
          ]
        },
        "schema_version": {
          "const": "belegt.graph/2026-10"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "required": [
        "rule",
        "schema_version",
        "checked_at"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "userActor": {
      "type": "string",
      "pattern": "^user:[a-z0-9_]+$"
    },
    "locator": {
      "type": "object",
      "properties": {
        "blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mime": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "sheet": {
          "type": "string"
        },
        "cell": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "text_excerpt_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  }
}