{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.belegt.org/graph/2026-10/mapping.json",
  "title": "Mapping",
  "type": "object",
  "required": [
    "id",
    "question_id",
    "datapoint_id",
    "confidence",
    "rank",
    "method",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^map_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "org_id": true,
    "version": true,
    "created_at": true,
    "created_by": true,
    "trust_zone": true,
    "provenance": true,
    "supersedes": true,
    "schema_version": true,
    "content_hash": true,
    "tags": true,
    "promotion": {
      "$ref": "common.json#/$defs/promotion"
    },
    "question_id": {
      "type": "string",
      "pattern": "^q_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "datapoint_id": {
      "$ref": "common.json#/$defs/datapointRef"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "method": {
      "enum": [
        "exact_template",
        "historical",
        "semantic",
        "human"
      ]
    },
    "template_mapping_ref": {
      "type": "string",
      "pattern": "^tm:[a-z0-9_]+@[0-9A-Za-z._-]+$"
    },
    "unit_hint": {
      "type": "string"
    },
    "period_hint": {
      "$ref": "common.json#/$defs/period"
    },
    "boundary_hint": {
      "$ref": "common.json#/$defs/boundary"
    },
    "transform": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unit_convert",
            "percent_to_ratio",
            "enum_map"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "candidate",
        "confirmed",
        "rejected"
      ]
    },
    "decided_by_cq": {
      "type": "string",
      "pattern": "^cq_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelope"
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "exact_template"
          }
        }
      },
      "then": {
        "required": [
          "template_mapping_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "human"
          }
        }
      },
      "then": {
        "properties": {
          "created_by": {
            "$ref": "common.json#/$defs/userActor"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trust_zone": {
            "const": "quarantine"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      }
    }
  ]
}