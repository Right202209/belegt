{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.belegt.org/graph/2026-10/audit_event.json",
  "title": "AuditEvent",
  "type": "object",
  "required": [
    "id",
    "org_id",
    "version",
    "created_at",
    "created_by",
    "seq",
    "action",
    "trace_id",
    "prev_hash",
    "event_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^aud_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "org_id": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "created_at": {
      "$ref": "common.json#/$defs/dateTime"
    },
    "created_by": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "object.create",
        "object.version",
        "object.promote",
        "edge.derive",
        "export.create",
        "egress.send",
        "egress.block",
        "auth.login",
        "authz.change",
        "authz.deny",
        "key.rotate",
        "policy.halt",
        "crypto.erase",
        "dsr.fulfil"
      ]
    },
    "object_ref": {
      "type": "string"
    },
    "content_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "prev_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "event_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "ip": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}