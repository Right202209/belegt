{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.belegt.org/graph/2026-10/trace.json",
  "title": "Trace",
  "type": "object",
  "required": [
    "id",
    "org_id",
    "span_id",
    "actor",
    "input_hash",
    "output_hash",
    "started_at",
    "ended_at",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "org_id": {
      "type": "string"
    },
    "span_id": {
      "type": "string"
    },
    "parent_span_id": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "pattern": "^(agent:[a-z-]+|service:[a-z-]+|user:[a-z0-9_]+)$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "model": {
      "type": "string"
    },
    "model_provider": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^prompt:[a-z-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "input_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "output_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "cost_eur": {
      "$ref": "common.json#/$defs/decStr"
    },
    "started_at": {
      "$ref": "common.json#/$defs/dateTime"
    },
    "ended_at": {
      "$ref": "common.json#/$defs/dateTime"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "halted"
      ]
    },
    "payload_blob": {
      "type": "string"
    }
  },
  "additionalProperties": false
}