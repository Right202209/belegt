{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.belegt.org/graph/2026-10/organization.json",
  "title": "Organization",
  "type": "object",
  "required": [
    "id",
    "legal_name",
    "country"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^org_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "org_id": true,
    "version": true,
    "created_at": true,
    "created_by": true,
    "trust_zone": true,
    "provenance": true,
    "supersedes": true,
    "schema_version": true,
    "content_hash": true,
    "tags": true,
    "legal_name": {
      "type": "string",
      "maxLength": 300
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "vat_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "eori": {
      "type": "string"
    },
    "default_consolidation": {
      "enum": [
        "operational_control",
        "financial_control",
        "equity_share"
      ]
    },
    "data_residency": {
      "enum": [
        "eu",
        "private"
      ]
    },
    "locale_default": {
      "enum": [
        "de",
        "en"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelope"
    }
  ]
}