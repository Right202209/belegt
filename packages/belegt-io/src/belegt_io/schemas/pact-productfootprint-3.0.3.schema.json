{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://schemas.belegt.org/io/pact-productfootprint-3.0.3.json",
 "title": "PACT ProductFootprint v3.0.3 (derived from the official PACT OpenAPI 3.0.3, components/schemas)",
 "$comment": "Source: https://docs.carbon-transparency.org/tr/data-exchange-protocol/latest/openapi.yaml (info.version 3.0.3). Descriptions removed; structure unchanged.",
 "$ref": "#/$defs/ProductFootprint",
 "$defs": {
  "CarbonFootprint": {
   "title": "CarbonFootprint",
   "type": "object",
   "required": [
    "declaredUnitOfMeasurement",
    "declaredUnitAmount",
    "productMassPerDeclaredUnit",
    "referencePeriodStart",
    "referencePeriodEnd",
    "pcfExcludingBiogenicUptake",
    "pcfIncludingBiogenicUptake",
    "fossilGhgEmissions",
    "fossilCarbonContent",
    "ipccCharacterizationFactors",
    "crossSectoralStandards",
    "exemptedEmissionsPercent"
   ],
   "oneOf": [
    {
     "oneOf": [
      {
       "required": [
        "geographyRegionOrSubregion"
       ]
      },
      {
       "required": [
        "geographyCountry"
       ]
      },
      {
       "required": [
        "geographyCountrySubdivision"
       ]
      }
     ]
    },
    {
     "not": {
      "anyOf": [
       {
        "required": [
         "geographyRegionOrSubregion"
        ]
       },
       {
        "required": [
         "geographyCountry"
        ]
       },
       {
        "required": [
         "geographyCountrySubdivision"
        ]
       }
      ]
     }
    }
   ],
   "properties": {
    "declaredUnitOfMeasurement": {
     "type": "string",
     "enum": [
      "liter",
      "kilogram",
      "cubic meter",
      "kilowatt hour",
      "megajoule",
      "ton kilometer",
      "square meter",
      "piece",
      "hour",
      "megabit second"
     ]
    },
    "declaredUnitAmount": {
     "$ref": "#/$defs/PositiveNonZeroDecimal"
    },
    "productMassPerDeclaredUnit": {
     "note": "mandatory in 3.0, optional in v2.x",
     "$ref": "#/$defs/Decimal"
    },
    "referencePeriodStart": {
     "type": "string",
     "format": "date-time"
    },
    "referencePeriodEnd": {
     "type": "string",
     "format": "date-time"
    },
    "geographyRegionOrSubregion": {
     "type": "string",
     "enum": [
      "Africa",
      "Americas",
      "Asia",
      "Europe",
      "Oceania",
      "Australia and New Zealand",
      "Central Asia",
      "Eastern Asia",
      "Eastern Europe",
      "Latin America and the Caribbean",
      "Melanesia",
      "Micronesia",
      "Northern Africa",
      "Northern America",
      "Northern Europe",
      "Polynesia",
      "South-eastern Asia",
      "Southern Asia",
      "Southern Europe",
      "Sub-Saharan Africa",
      "Western Asia",
      "Western Europe"
     ]
    },
    "geographyCountry": {
     "type": "string",
     "pattern": "^[A-Z]{2}$",
     "comment": "ISO 3166-1 alpha-2"
    },
    "geographyCountrySubdivision": {
     "type": "string",
     "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
     "comment": "ISO 3166-2"
    },
    "boundaryProcessesDescription": {
     "note": "optional in 3.0, was mandatory in 2.x",
     "type": "string"
    },
    "pcfExcludingBiogenicUptake": {
     "$ref": "#/$defs/Decimal"
    },
    "pcfIncludingBiogenicUptake": {
     "$ref": "#/$defs/Decimal"
    },
    "fossilCarbonContent": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "biogenicCarbonContent": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "recycledCarbonContent": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "fossilGhgEmissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "landUseChangeGhgEmissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "landCarbonLeakage": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "landManagementFossilGhgEmissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "landManagementBiogenicCO2Emissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "landManagementBiogenicCO2Removals": {
     "$ref": "#/$defs/NegativeOrZeroDecimal"
    },
    "biogenicCO2Uptake": {
     "$ref": "#/$defs/NegativeOrZeroDecimal"
    },
    "biogenicNonCO2Emissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "landAreaOccupation": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "aircraftGhgEmissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "packagingEmissionsIncluded": {
     "type": "boolean"
    },
    "packagingGhgEmissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "packagingBiogenicCarbonContent": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "outboundLogisticsGhgEmissions": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "ccsTechnologicalCO2CaptureIncluded": {
     "type": "boolean"
    },
    "ccsTechnologicalCO2Capture": {
     "$ref": "#/$defs/NegativeOrZeroDecimal"
    },
    "technologicalCO2CaptureOrigin": {
     "type": "string"
    },
    "technologicalCO2Removals": {
     "$ref": "#/$defs/NegativeOrZeroDecimal"
    },
    "ccuCarbonContent": {
     "$ref": "#/$defs/PositiveOrZeroDecimal"
    },
    "ccuCalculationApproach": {
     "type": "string",
     "enum": [
      "Cut-off",
      "Credit"
     ]
    },
    "ccuCreditCertification": {
     "$ref": "#/$defs/Uri"
    },
    "ipccCharacterizationFactors": {
     "note": "supersedes `characterizationFactors` deprecated in 2.3.",
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^AR\\d+$"
     },
     "minItems": 1,
     "uniqueItems": true
    },
    "crossSectoralStandards": {
     "note": "Supersedes `crossSectoralStandardsUsed` deprecated in version 2.3.",
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "uniqueItems": true
    },
    "productOrSectorSpecificRules": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ProductOrSectorSpecificRule"
     },
     "minItems": 1,
     "uniqueItems": true,
     "note": "Multiple ProductOrSpecificRules can be specifed, each with its own operator and ruleNames."
    },
    "exemptedEmissionsPercent": {
     "note": "string<decimal> in 3.0, was Number in 2.x. Removed upper boundary of 5%.",
     "$ref": "#/$defs/Decimal"
    },
    "exemptedEmissionsDescription": {
     "note": "optional in 3.0, was mandatory in 2.x",
     "type": "string"
    },
    "allocationRulesDescription": {
     "type": "string"
    },
    "secondaryEmissionFactorSources": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/EmissionFactorSource"
     }
    },
    "primaryDataShare": {
     "note": "string<decimal> in 3.0, was Number in 2.x",
     "$ref": "#/$defs/Decimal"
    },
    "dqi": {
     "$ref": "#/$defs/DataQualityIndicators"
    },
    "verification": {
     "$ref": "#/$defs/Verification"
    }
   }
  },
  "DataModelExtension": {
   "title": "DataModelExtension",
   "type": "object",
   "required": [
    "specVersion",
    "dataSchema",
    "data"
   ],
   "properties": {
    "specVersion": {
     "type": "string"
    },
    "dataSchema": {
     "type": "string",
     "format": "uri"
    },
    "documentation": {
     "type": "string",
     "format": "uri"
    },
    "data": {
     "type": "object"
    }
   }
  },
  "DataQualityIndicators": {
   "title": "DataQualityIndicators",
   "type": "object",
   "required": [
    "technologicalDQR",
    "geographicalDQR",
    "temporalDQR"
   ],
   "properties": {
    "technologicalDQR": {
     "note": "string<decimal> in 3.0, was Number in 2.x",
     "$ref": "#/$defs/Decimal"
    },
    "geographicalDQR": {
     "note": "string<decimal> in 3.0, was Number in 2.x",
     "$ref": "#/$defs/Decimal"
    },
    "temporalDQR": {
     "note": "string<decimal> in 3.0, was Number in 2.x",
     "$ref": "#/$defs/Decimal"
    }
   }
  },
  "Decimal": {
   "type": "string",
   "format": "decimal",
   "pattern": "^[+-]?\\d+(\\.\\d+)?$"
  },
  "EmissionFactorSource": {
   "title": "EmissionFactorSource",
   "type": "object",
   "required": [
    "name",
    "version"
   ],
   "properties": {
    "name": {
     "$ref": "#/$defs/NonEmptyString"
    },
    "version": {
     "$ref": "#/$defs/NonEmptyString"
    }
   }
  },
  "NegativeOrZeroDecimal": {
   "type": "string",
   "format": "decimal",
   "pattern": "^(-\\d+(\\.\\d+)?)|0+(\\.0+)?$",
   "comment": "<= 0"
  },
  "NonEmptyString": {
   "type": "string",
   "minLength": 1
  },
  "PositiveNonZeroDecimal": {
   "type": "string",
   "format": "decimal",
   "pattern": "^[+]?(\\d*[1-9]\\d*)(\\.\\d+)?|(0+\\.\\d*[1-9]\\d*)$",
   "comment": "> 0"
  },
  "PositiveOrZeroDecimal": {
   "type": "string",
   "format": "decimal",
   "pattern": "^[+]?\\d+(\\.\\d+)?$",
   "comment": ">= 0"
  },
  "ProductFootprint": {
   "type": "object",
   "title": "ProductFootprint",
   "required": [
    "id",
    "specVersion",
    "created",
    "status",
    "companyName",
    "companyIds",
    "productDescription",
    "productIds",
    "productNameCompany",
    "pcf"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "specVersion": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+\\.\\d+(-\\d{8})?$"
    },
    "precedingPfIds": {
     "type": "array",
     "items": {
      "type": "string",
      "format": "uuid"
     },
     "minItems": 1,
     "uniqueItems": true
    },
    "created": {
     "type": "string",
     "format": "date-time"
    },
    "status": {
     "type": "string",
     "enum": [
      "Active",
      "Deprecated"
     ]
    },
    "validityPeriodStart": {
     "type": "string",
     "format": "date-time"
    },
    "validityPeriodEnd": {
     "type": "string",
     "format": "date-time"
    },
    "companyName": {
     "$ref": "#/$defs/NonEmptyString"
    },
    "companyIds": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/Urn"
     }
    },
    "productDescription": {
     "type": "string"
    },
    "productIds": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/Urn"
     }
    },
    "productClassifications": {
     "note": "Replaces productCategoryCpc deprecated in 2.3",
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/Urn"
     }
    },
    "productNameCompany": {
     "$ref": "#/$defs/NonEmptyString"
    },
    "comment": {
     "type": "string"
    },
    "pcf": {
     "$ref": "#/$defs/CarbonFootprint"
    },
    "extensions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/DataModelExtension"
     }
    }
   }
  },
  "ProductOrSectorSpecificRule": {
   "title": "ProductOrSectorSpecificRule",
   "type": "object",
   "required": [
    "operator",
    "ruleNames"
   ],
   "properties": {
    "operator": {
     "type": "string",
     "enum": [
      "PEF",
      "EPD International",
      "Other"
     ]
    },
    "ruleNames": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1,
     "uniqueItems": true
    },
    "otherOperatorName": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "Uri": {
   "type": "string",
   "format": "uri"
  },
  "Urn": {
   "type": "string",
   "format": "urn",
   "pattern": "^([uU][rR][nN]):"
  },
  "Verification": {
   "title": "Verification",
   "note": "Renamed from `Assurance` in 3.0",
   "type": "object",
   "properties": {
    "coverage": {
     "type": "string",
     "note": "values changed from v2.x",
     "enum": [
      "PCF calculation model",
      "PCF program",
      "product level"
     ]
    },
    "providerName": {
     "note": "optional in version 3.0 was mandatory in 2.x",
     "type": "string"
    },
    "completedAt": {
     "type": "string",
     "format": "date-time"
    },
    "standardName": {
     "type": "string"
    },
    "comments": {
     "type": "string"
    }
   }
  }
 }
}