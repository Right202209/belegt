        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "belegt-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(belegt_request_stage_duration_seconds_bucket[1h])))",
          "legendFormat": "{{stage}}"
