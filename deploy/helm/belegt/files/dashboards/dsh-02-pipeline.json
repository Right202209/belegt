  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "首稿时长 P95（NFR-07：MVP ≤ 60 min，V1 ≤ 30 min）",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "belegt-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "belegt-prom"
          },
          "expr": "belegt:first_draft_seconds:p95_1d",
          "legendFormat": "{{deploy_profile}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "首稿时长 P50",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "belegt-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "belegt-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(belegt_request_first_draft_seconds_bucket[1d])))",
          "legendFormat": "P50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
