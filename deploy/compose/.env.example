# =============================================================================================
# Belegt docker compose 环境变量（Spec: 10 §6.1/§6.3/§6.4、07 §4.5/§5、08 §6.2）
# 用法：cp .env.example .env，把所有标注【必改】的值换成随机强密码（openssl rand -hex 32）。
# .env 含密钥，不得提交到 Git；生产（Helm）改用 Kubernetes Secret / Vault（07 §4.5）。
# =============================================================================================

# ----------------------------------------------------------------- 部署形态
# 10 §8.1 deployment.environment：dev | ci | eval | staging | prod-eu1 | dr-eu2
BELEGT_ENV=dev
# 10 §6.1 deploy-profile：private-compose（单机私有化/试点）| private-airgap（离线，只允许本地模型）| saas-multi 等
BELEGT_DEPLOY_PROFILE=private-compose
# 镜像仓库与版本（docker compose build 时作为镜像名；离线包导入后指向本地仓库）
BELEGT_IMAGE_REGISTRY=belegt
BELEGT_VERSION=0.1.0
# 发布端口绑定地址。默认只监听本机，由主机上的 TLS 反向代理（Caddy/nginx/Traefik）对外；0.0.0.0 = 所有网卡（不推荐）
BIND_ADDR=127.0.0.1
# 07 §5 数据驻留标记（eu | private）；private-airgap 时设为 private
BELEGT_DATA_RESIDENCY=eu

# ----------------------------------------------------------------- PostgreSQL 16 + pgvector（03 §6）
POSTGRES_IMAGE=pgvector/pgvector:pg16
# 超级用户：仅迁移 Job、Temporal auto-setup、备份与 postgres-exporter 使用；应用不使用超级用户
POSTGRES_SUPERUSER=postgres
# 【必改】
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres-superuser
# 证据图数据库名（Temporal 使用同实例的 temporal / temporal_visibility 两个库，10 §6.3）
BELEGT_DB_NAME=belegt
# 应用登录账号（API 与可信区 worker）：迁移 Job 创建，授予 belegt_writer + belegt_reader_trusted（03 §6.1）
BELEGT_DB_APP_USER=belegt_app
# 【必改】
BELEGT_DB_APP_PASSWORD=change-me-app
# 隔离区登录账号：只授予 belegt_reader_quarantine（07 §2.2；profile zones 的隔离区 worker 使用）
BELEGT_DB_QUARANTINE_USER=belegt_quarantine
# 【必改】
BELEGT_DB_QUARANTINE_PASSWORD=change-me-quarantine
# 审计只读账号（auditor_readonly、外部审计导出）：只授予 belegt_auditor
BELEGT_DB_AUDITOR_USER=belegt_auditor_ro
# 【必改】
BELEGT_DB_AUDITOR_PASSWORD=change-me-auditor
# 哈希分区数（03 §6.4）：私有化单租户 1；多租户 SaaS 32。只在首次迁移建表时生效，之后不可改
BELEGT_PG_HASH_MODULUS=1
# on = 每次写入在同一事务内调用 graph.commit_version()（数据库层 RLS/CHECK/审计哈希链）；off 仅用于排障
BELEGT_PG_COMMIT=on
# WAL 归档（10 §6.6：开启后 private-compose 的 RPO 从 ≤ 24 h 降到 ≤ 15 min；需另配 archive_command / WAL-G）
PG_ARCHIVE_MODE=off

# ----------------------------------------------------------------- 对象存储（MinIO，S3 兼容；03 §6.7）
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=belegt-minio
# 【必改】至少 8 位
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
# 主桶：org/<org_id>/blobs、audit-packs、traces …（03 §6.7 布局）
BELEGT_S3_BUCKET=belegt-eu-dev
BELEGT_S3_REGION=eu-central-1
# Object Lock：dev 用 GOVERNANCE 1 天便于清理；生产 blobs/ 与 audit-packs/ 须 COMPLIANCE 3650 天（10 年，03 §6.7）
BELEGT_OBJECT_LOCK_MODE=GOVERNANCE
BELEGT_OBJECT_LOCK_DAYS=1
# 备份桶（10 §6.6：备份桶 Object Lock 35 天）；生产应在另一区域/另一服务商
BELEGT_BACKUP_BUCKET=belegt-eu-dev-backup
BELEGT_BACKUP_LOCK_DAYS=35

# ----------------------------------------------------------------- Temporal（04 §1.3、10 §3.2）
TEMPORAL_IMAGE=temporalio/auto-setup:1.26.2
TEMPORAL_UI_IMAGE=temporalio/ui:2.34.0
TEMPORAL_UI_PORT=8233
BELEGT_TEMPORAL_NAMESPACE=default
BELEGT_TEMPORAL_TASK_QUEUE=belegt-requests
# history shard 数：部署后不可更改，须一次定够（10 §3.2 V1 = 512；单机试点可 4–16 以省资源）
TEMPORAL_HISTORY_SHARDS=512

# ----------------------------------------------------------------- belegt-api / worker / web
BELEGT_API_WORKERS=2
# 开发令牌表（belegt_core.api.auth.StaticTokenTable）。生产必须换 OIDC TokenResolver（07 §4.6）且不挂载此文件
BELEGT_DEV_TOKENS_FILE=./config/dev-tokens.example.json
# worker 使用的服务工厂（module:function，返回 agents.base.Services）；默认演示租户
BELEGT_SERVICES_FACTORY=belegt_core.demo:build_env
# web 构建时的 API 前缀（经 nginx /api/ 反代到 belegt-api）；留空 = 内置 mock 演示数据
BELEGT_WEB_API_BASE=/api
BELEGT_WEB_PORT=8080

# ----------------------------------------------------------------- LLM（04 §7、07 §5.3、10 §4/§6.4）
# 任意 OpenAI 兼容端点：
#   云端（经 egress-gateway，白名单见 egress/allowlist.txt）：https://api.mistral.ai/v1
#   本地 Ollama（--profile ollama）：http://ollama:11434/v1
#   本地 vLLM（--profile vllm）：http://vllm:8000/v1
# 留空 = worker 使用确定性 MockLLM（演示，不调用任何模型）
BELEGT_LLM_BASE_URL=
# 云端 provider 密钥（只给 worker；生产放 Vault，仅 llm-proxy 可读）
BELEGT_LLM_API_KEY=
BELEGT_LLM_MODEL=
# 隔离区 worker（profile zones）强制使用本地小模型，减少外部内容送往第三方（07 §5.3）
BELEGT_QUARANTINE_LLM_BASE_URL=http://ollama:11434/v1
BELEGT_QUARANTINE_LLM_MODEL=qwen3:8b
OLLAMA_IMAGE=ollama/ollama:latest
# vLLM（生产推理，需 NVIDIA GPU + nvidia-container-toolkit；10 §6.4 gpu-profile）
VLLM_IMAGE=vllm/vllm-openai:v0.6.3
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEM_UTIL=0.90
VLLM_GPU_COUNT=1
# 1 = 只用本地权重（airgap）；首次联网下载权重时临时设为 0 并在 allowlist 放行 .huggingface.co
VLLM_HF_OFFLINE=1

# ----------------------------------------------------------------- 出口网关（07 §2.2：唯一出公网的容器）
SQUID_IMAGE=ubuntu/squid:latest

# ----------------------------------------------------------------- 供应商端（08 §6.2）
BELEGT_SUPPLIER_PORT=8090
# 门户对外地址（魔法链接域名）
BELEGT_SUPPLIER_PUBLIC_URL=http://localhost:8090
# 【必改】魔法链接派生/签名、CSRF；改动后旧链接全部失效
BELEGT_SUPPLIER_SECRET=change-me-supplier-instance-secret
# 【必改】校验客户侧请求清单 JWS（与 core 侧一致）
BELEGT_SUPPLIER_MANIFEST_SECRET=change-me-manifest-jws
# 【必改】双向 Webhook HMAC（180 天轮换，10 §8.5）
BELEGT_SUPPLIER_WEBHOOK_SECRET=change-me-webhook-hmac
# 非空则启用 /supplier-api/v1/admin/*（Bearer）
BELEGT_SUPPLIER_ADMIN_KEY=
# SMTP：留空 = 写 /data/outbox/*.eml（开发）。生产使用内部 SMTP 中继（经 egress 管控）
BELEGT_SUPPLIER_SMTP_HOST=
BELEGT_SUPPLIER_SMTP_PORT=587
BELEGT_SUPPLIER_SMTP_USER=
BELEGT_SUPPLIER_SMTP_PASSWORD=
BELEGT_SUPPLIER_MAIL_FROM=
BELEGT_SUPPLIER_TRUST_PROXY=false
BELEGT_SUPPLIER_DEFAULT_LOCALE=de

# ----------------------------------------------------------------- 观测（10 §5）
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
PROMETHEUS_IMAGE=prom/prometheus:v2.55.0
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.15.0
GRAFANA_IMAGE=grafana/grafana:11.3.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# 【必改】
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ----------------------------------------------------------------- 备份（--profile backup；10 §6.6）
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_LOCAL=3
